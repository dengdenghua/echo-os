[Unit]
Description=Echo OS development preview Agent in the active X11 session
After=graphical-session-pre.target

[Service]
Type=simple
WorkingDirectory=/home/echo/.local/share/echo-preview
Environment=HOME=/home/echo
Environment=ECHO_DATA_DIR=/home/echo/.local/share/echo-preview
Environment=ECHO_HOME=/home/echo/.local/share/echo-preview
Environment=ECHO_WEBUI_DIST=/opt/echo-os/frontend/dist
Environment=ECHO_APPLIANCE=1
Environment=ECHO_APP_EXTENSIONS=appliance.extension
Environment=ECHO_REQUIRED_APP_EXTENSIONS=1
Environment=ECHO_PROMPT_SKILL_REFRESH_DEADLINE_S=0
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/echo-os/.venv/bin/python -m runtime serve --config /home/echo/.local/share/echo-preview/config.yaml --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
